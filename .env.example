# Copy to .env. Never commit .env.
# JWT signing secret: REQUIRED outside dev_stub auth mode. Generate: python -c "import secrets;print(secrets.token_hex(32))"
PHL_JWT_SECRET=
# Database URL (default: SQLite file in data/cache). Postgres example for docker-compose:
# PHL_DATABASE_URL=postgresql+psycopg://phl:phl@db:5432/phl
PHL_DATABASE_URL=
# Optional: data.gov.in OGD API key (owner registers at data.gov.in). Not needed for the demo.
DATAGOV_API_KEY=
# Test-only. Never set in a deployment.
# PHL_RATE_LIMIT_MULTIPLIER=
