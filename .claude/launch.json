{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "reports",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "reports"
      ],
      "port": 8765
    },
    {
      "name": "demo",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "tasks.py",
        "demo"
      ],
      "port": 8000
    },
    {
      "name": "platform-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "platform_api.api.main:app", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "prototype",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "prototype", "run", "dev"],
      "port": 5173
    }
  ]
}