# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.egg-info/

# Node
node_modules/
frontend/dist/
prototype/dist/
frontend/dev-dist/
frontend/test-results/
frontend/playwright-report/

# Secrets / local env
.env
*.local

# Databases (rebuilt by `tasks.py load`)
*.sqlite
*.sqlite3
*.db

# Large raw downloads: the MANIFEST.json files are committed, payloads are cached locally.
# Small raw payloads (< 5 MB) are committed so the pipeline can be re-run offline from a clean clone.
data/raw/**/*.graphml
data/raw/**/*.osm
data/raw/**/*.pbf
data/cache/**
!data/cache/.gitkeep

# OS
Thumbs.db
.DS_Store
reports/sim/*/runs/
frontend/*.tsbuildinfo
# Source archive is built from git (git archive); not committed

# India platform (plan v2): large generated artefacts, rebuilt by pipelines/v2/*
data/processed/india/edges.parquet
data/processed/india/nodes.parquet
data/processed/india/render/roads.pmtiles
data/app/
